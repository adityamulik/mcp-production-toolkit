# Dashboard Dockerfile - React/TypeScript/Vite
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dashboard files
COPY dashboard/package*.json ./
RUN npm install

COPY dashboard/tsconfig.json ./
COPY dashboard/tsconfig.node.json ./
COPY dashboard/vite.config.ts ./
COPY dashboard/index.html ./
COPY dashboard/src ./src

# Create .env file with Vite API URL (Vite reads from .env during build)
ARG VITE_API_URL=http://localhost:3000
RUN echo "VITE_API_URL=${VITE_API_URL}" > .env && cat .env

# Build the app - Vite will read from .env file
RUN npm run build

# Production stage - serve with a simple HTTP server
FROM node:20-alpine

WORKDIR /app

# Install serve to run production build
RUN npm install -g serve

# Copy built app
COPY --from=builder /app/dist ./dist

EXPOSE 5173

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5173/ || exit 1

CMD ["serve", "-s", "dist", "-l", "5173"]
