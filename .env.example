# MCP Production Toolkit - Environment Configuration
# Copy this file to .env.local and update with your actual values
# .env.local is git-ignored and should NOT be committed

# ==================================================
# OAUTH & AUTHENTICATION
# ==================================================

# Analyst User (Team A - Analytics Access)
ANALYST_EMAIL=analyst@company.com
ANALYST_PASSWORD=analyst123

# Deployer User (Team B - DevOps Access)
DEPLOYER_EMAIL=deployer@company.com
DEPLOYER_PASSWORD=deploy123

# Developer User (Team C - Developer Access)
DEVELOPER_EMAIL=developer@company.com
DEVELOPER_PASSWORD=dev123

# Admin User
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=admin123

# ==================================================
# SERVER CONFIGURATION
# ==================================================

# OAuth Server
OAUTH_SERVER_URL=http://localhost:3000
OAUTH_TOKEN_ENDPOINT=/oauth/token

# Gateway Configuration
GATEWAY_PORT=3000
GATEWAY_JWT_SECRET=your-super-secret-jwt-key-change-this

# ==================================================
# DATABASE CONFIGURATION (if applicable)
# ==================================================

# Analytics Database
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=analytics_db
ANALYTICS_DB_USER=postgres
ANALYTICS_DB_PASSWORD=postgres

# ==================================================
# DASHBOARD CONFIGURATION
# ==================================================

DASHBOARD_PORT=5173
DASHBOARD_API_URL=http://localhost:3000

# ==================================================
# MCP SERVERS
# ==================================================

# Team A - Analytics Server
TEAM_A_PORT=8001

# Team B - DevOps Server
TEAM_B_PORT=8002

# Team C - Developer Server
TEAM_C_PORT=8003
